# ---- App ----
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ---- Embedding ----
# 可选: huggingface | openai
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# 当 EMBEDDING_PROVIDER=openai 时使用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Splitter ----
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ---- Vector Store ----
CHROMA_COLLECTION=rag_knowledge

# ---- Auth ----
# JWT_SECRET 生产环境必须换成随机字符串，可以用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成
JWT_SECRET=please-change-this-to-a-random-string
JWT_EXPIRE_MINUTES=10080
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

AGENT_MAX_ITERATIONS=8